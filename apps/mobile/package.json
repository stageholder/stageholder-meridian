{
  "name": "@meridian/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start --localhost",
    "start:clean": "expo start --localhost --clear",
    "start:lan": "expo start --lan",
    "dev:ios": "expo start --localhost --ios",
    "dev:android": "expo start --localhost --android",
    "dev:tunnel": "expo start --tunnel",
    "prod": "set -a; . ./.env.prod; set +a; expo start --localhost --clear",
    "prod:ios": "set -a; . ./.env.prod; set +a; expo start --tunnel --go --ios --clear",
    "prod:android": "set -a; . ./.env.prod; set +a; expo start --localhost --android --clear",
    "ios": "expo run:ios",
    "android": "bash scripts/android-dev.sh",
    "android:expo": "expo run:android",
    "android:reverse": "bash scripts/android-reverse.sh",
    "prebuild": "expo prebuild",
    "doctor": "bunx expo-doctor",
    "align-deps": "bunx expo install --fix",
    "build:dev:ios": "bunx eas-cli build --profile development --platform ios",
    "build:dev:android": "bunx eas-cli build --profile development --platform android",
    "build:dev-device:ios": "bunx eas-cli build --profile development-device --platform ios",
    "build:dev-device:android": "bunx eas-cli build --profile development-device --platform android",
    "build:preview:ios": "bunx eas-cli build --profile preview --platform ios",
    "build:preview:android": "bunx eas-cli build --profile preview --platform android",
    "build:prod:ios": "bunx eas-cli build --profile production --platform ios",
    "build:prod:android": "bunx eas-cli build --profile production --platform android",
    "build:prod:all": "bunx eas-cli build --profile production --platform all",
    "submit:ios": "bunx eas-cli submit --profile production --platform ios",
    "submit:android": "bunx eas-cli submit --profile production --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/core": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/features": "workspace:*",
    "@shopify/flash-list": "^2.3.1",
    "@stageholder/sdk": "^1.0.0-alpha.60",
    "@stageholder/ui": "^0.3.0-alpha.121",
    "@tamagui/config": "^2.3.2",
    "@tamagui/core": "^2.3.2",
    "@tamagui/lucide-icons-2": "^2.3.2",
    "@tamagui/native": "^2.3.2",
    "@tamagui/toast": "^2.3.2",
    "@tamagui/web": "^2.3.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.9",
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-purchases": "^9.0.0",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "^0.7.16",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "^2.3.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@tamagui/babel-plugin": "^2.3.2",
    "@tamagui/metro-plugin": "^2.3.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "^5.3.0"
  }
}
