{
  "name": "@meridian/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start --localhost",
    "start:clean": "expo start --localhost --clear",
    "start:lan": "expo start --lan",
    "dev:ios": "expo start --localhost --ios",
    "dev:android": "expo start --localhost --android",
    "dev:tunnel": "expo start --tunnel",
    "prod": "set -a; . ./.env.prod; set +a; expo start --localhost --clear",
    "prod:ios": "set -a; . ./.env.prod; set +a; expo start --tunnel --go --ios --clear",
    "prod:android": "set -a; . ./.env.prod; set +a; expo start --localhost --android --clear",
    "ios": "expo run:ios",
    "android": "bash scripts/android-dev.sh",
    "android:expo": "expo run:android",
    "android:reverse": "bash scripts/android-reverse.sh",
    "prebuild": "expo prebuild",
    "doctor": "bunx expo-doctor",
    "align-deps": "bunx expo install --fix",
    "build:dev:ios": "bunx eas-cli build --profile development --platform ios",
    "build:dev:android": "bunx eas-cli build --profile development --platform android",
    "build:dev-device:ios": "bunx eas-cli build --profile development-device --platform ios",
    "build:dev-device:android": "bunx eas-cli build --profile development-device --platform android",
    "build:preview:ios": "bunx eas-cli build --profile preview --platform ios",
    "build:preview:android": "bunx eas-cli build --profile preview --platform android",
    "build:prod:ios": "bunx eas-cli build --profile production --platform ios",
    "build:prod:android": "bunx eas-cli build --profile production --platform android",
    "build:prod:all": "bunx eas-cli build --profile production --platform all",
    "submit:ios": "bunx eas-cli submit --profile production --platform ios",
    "submit:android": "bunx eas-cli submit --profile production --platform android",
    "typecheck": "tsc --noEmit",
    "e2e": "bun e2e/run.ts",
    "e2e:metro": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_STAGEHOLDER_ISSUER_URL=http://localhost:4828/oidc EXPO_PUBLIC_MERIDIAN_API_URL=http://localhost:4000/api/v1 EXPO_PUBLIC_STAGEHOLDER_CLIENT_ID=meridian-mobile expo start --localhost --dev-client --no-dev --minify --clear",
    "e2e:android": "bun e2e/run.ts --android",
    "e2e:android:release": "bun e2e/run.ts --android --release",
    "e2e:studio": "maestro studio",
    "e2e:build:android": "cd android && EXPO_NO_DOTENV=1 EXPO_PUBLIC_STAGEHOLDER_ISSUER_URL=http://localhost:4828/oidc EXPO_PUBLIC_MERIDIAN_API_URL=http://localhost:4000/api/v1 EXPO_PUBLIC_STAGEHOLDER_CLIENT_ID=meridian-mobile ./gradlew assembleRelease -PreactNativeArchitectures=${E2E_ABI:-arm64-v8a} --init-script ../e2e/android/cleartext.init.gradle && adb install -r app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.1",
    "@expo/metro-runtime": "~56.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/core": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/features": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "@stageholder/sdk": "1.0.0-alpha.71",
    "@stageholder/ui": "^0.4.0-alpha.2",
    "@tamagui/config": "^2.3.2",
    "@tamagui/core": "^2.3.2",
    "@tamagui/lucide-icons-2": "^2.3.2",
    "@tamagui/native": "^2.3.2",
    "@tamagui/toast": "^2.3.2",
    "@tamagui/web": "^2.3.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.9",
    "expo": "~56.0.0",
    "expo-auth-session": "~56.0.16",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-nitro-modules": "^0.36.4",
    "react-native-purchases": "^10.5.0",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "tamagui": "^2.3.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@tamagui/babel-plugin": "^2.3.2",
    "@tamagui/metro-plugin": "^2.3.2",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "typescript": "~6.0.3"
  }
}
